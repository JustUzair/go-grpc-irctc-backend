# user-service
USER_SERVICE_PORT=8100

# booking-service
BOOKING_SERVICE_PORT=8101

# payment-service
PAYMENT_SERVICE_PORT=8102

# search-service
SEARCH_SERVICE_PORT=8103

# logging
# info emits INFO, WARN, and ERROR logs. Use debug for additional debugging logs.
LOG_LEVEL=info
# text uses compact, colorized console output. Use json for structured production logs.
LOG_FORMAT=text
# Uncomment to disable ANSI colors while keeping compact text output.
# NO_COLOR=1


REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=irctcadmin
USER_DATABASE_URL=postgres://user_service:password@localhost:5400/user_db?sslmode=disable
BOOKING_DATABASE_URL=postgres://booking_service:password@localhost:5400/booking_db?sslmode=disable
PAYMENT_DATABASE_URL=postgres://payment_service:password@localhost:5400/payment_db?sslmode=disable
TEST_DATABASE_URL=postgres://admin:irctcadmin@localhost:5400/tests_db?sslmode=disable


MAILER_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_NAME=IRCTC-Go
EMAIL_FROM_ADDRESS=no-reply@irctc-go.com

# Mailtrap Email Sandbox integration test
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_TEST_RECIPIENT=integration@example.com


OTP_TTL=300
OTP_RATE_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HMAC_SECRET=

JWT_ACCESS_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXP=900
REFRESH_TOKEN_EXP=2628000
REDIS_USER_TTL=86400
