# user-service
USER_SERVICE_PORT=8000

# booking-service
BOOKING_SERVICE_PORT=8001

# payment-service
PAYMENT_SERVICE_PORT=8002

# search-service
SEARCH_SERVICE_PORT=8003

# logging
# info emits INFO, WARN, and ERROR logs. Use debug for additional debugging logs.
LOG_LEVEL=info
# text uses compact, colorized console output. Use json for structured production logs.
LOG_FORMAT=text
# Uncomment to disable ANSI colors while keeping compact text output.
# NO_COLOR=1


REDIS_PORT=6000
USER_DATABASE_URL=postgres://user_service:password@postgres:5432/user_db
BOOKING_DATABASE_URL=postgres://booking_service:password@postgres:5432/booking_db
PAYMENT_DATABASE_URL=postgres://payment_service:password@postgres:5432/payment_db


RESEND_API_KEY=
EMAIL_FROM_NAME=IRCTC-Go
EMAIL_FROM_ADDRESS=no-reply@irctc-go.com
