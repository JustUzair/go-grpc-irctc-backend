<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Your email has been verified</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f4f7fb; color: #172033; font-family: Arial, Helvetica, sans-serif;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">
      Your email address has been verified successfully.
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #f4f7fb;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #dde4ee; border-radius: 12px;">
            <tr>
              <td style="padding: 32px;">
                <p style="margin: 0 0 24px; color: #1856a8; font-size: 20px; font-weight: 700;">
                  IRCTC Go
                </p>

                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 0 20px;">
                  <tr>
                    <td align="center" width="48" height="48" style="width: 48px; height: 48px; background-color: #e8f7ee; border-radius: 24px; color: #18794e; font-size: 26px; font-weight: 700; line-height: 48px;">
                      &#10003;
                    </td>
                  </tr>
                </table>

                <h1 style="margin: 0 0 16px; color: #172033; font-size: 28px; line-height: 36px;">
                  Email verified
                </h1>

                <p style="margin: 0 0 16px; color: #445069; font-size: 16px; line-height: 24px;">
                  {{if .Name}}Hi {{.Name}},{{else}}Hello,{{end}}
                </p>

                <p style="margin: 0; color: #445069; font-size: 16px; line-height: 24px;">
                  Your email address has been verified successfully. Your IRCTC Go account is now ready for the next step in registration.
                </p>

                <p style="margin: 24px 0 0; color: #69758c; font-size: 14px; line-height: 22px;">
                  If you did not perform this verification, contact support immediately so the account can be reviewed.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding: 20px 32px; background-color: #f8fafc; border-top: 1px solid #e7ebf1; border-radius: 0 0 12px 12px;">
                <p style="margin: 0; color: #7b8598; font-size: 12px; line-height: 18px;">
                  This is an automated transactional email. Please do not reply.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
